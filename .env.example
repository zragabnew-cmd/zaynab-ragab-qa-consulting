# Public canonical URL of the site (used for SEO, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://example.com

# Booking link for the discovery call / paid consultation (Calendly, Cal.com, etc.)
NEXT_PUBLIC_BOOKING_URL=

# Hosted payment link for the 1-hour consultation (create a payment link in Paymob / Fawry Pay and paste it)
NEXT_PUBLIC_PAYMENT_URL=

# WhatsApp number, international format, digits only (e.g. 201001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form delivery — set ONE of the options below.
# Option A: forward the lead as JSON to a webhook (Zapier, Make, Formspree, your CRM)
CONTACT_WEBHOOK_URL=
# Option B: send email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
